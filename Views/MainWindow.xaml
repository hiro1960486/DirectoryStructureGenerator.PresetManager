<Window x:Class="DirectoryStructureGenerator.PresetManager.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:m="clr-namespace:DirectoryStructureGenerator.PresetManager.Models"
 Title="DirectoryStructureGenerator - プリセット管理 v1.1" Width="1320" Height="820" MinWidth="1060" MinHeight="680" Background="{StaticResource AppBackground}">
 <DockPanel Margin="12">
  <Border DockPanel.Dock="Top" Background="#172033" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="プリセット管理 v1.1" FontSize="22" FontWeight="Bold" Foreground="White"/><TextBlock Text="CSV ⇄ 設定モデル ⇄ UI" Foreground="#AAB4C3"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="新規" Click="New_Click"/><Button Content="編集" Click="Edit_Click"/><Button Content="削除" Click="Delete_Click"/><Button Content="CSV保存" Click="Save_Click"/><Button Content="再読込" Click="Reload_Click"/></StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D6DCE6" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="現在の保存先" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,12,0"/>
    <TextBlock Grid.Column="1" Text="{Binding PresetFilePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PresetFilePath}"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="保存先変更" Click="ChangeStorage_Click"/><Button Content="保存先を開く" Click="OpenStorage_Click"/><Button Content="既定に戻す" Click="ResetStorage_Click"/></StackPanel>
   </Grid>
  </Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="7" Padding="12"><DockPanel><TextBox DockPanel.Dock="Top" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}"/><TextBlock DockPanel.Dock="Top" Text="登録済み・追加中" FontWeight="Bold" FontSize="15" Margin="0,8"/><ListBox ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type m:Preset}"><Border BorderBrush="#E4E8EF" BorderThickness="0,0,0,1" Padding="4,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Badges}" Foreground="#2864DC" FontWeight="Bold"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Memo}" Foreground="#6C7788" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
   <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"/>
   <Border Grid.Column="2" Background="White" CornerRadius="7" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding Selected}"><TextBlock Text="{Binding Name}" FontSize="25" FontWeight="Bold"/><TextBlock Text="{Binding Memo}" Foreground="#6C7788" Margin="0,4,0,14" TextWrapping="Wrap"/><GroupBox Header="実行情報"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="入力元"/><TextBlock Grid.Column="1" Text="{Binding SourceDisplay}" TextWrapping="Wrap"/><TextBlock Grid.Row="1" Text="出力先"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OutputDisplay}" TextWrapping="Wrap"/></Grid></GroupBox><GroupBox Header="対象・除外"><StackPanel><TextBlock Text="対象拡張子" FontWeight="Bold"/><TextBlock Text="{Binding IncludedExtensionsDisplay}" TextWrapping="Wrap"/><TextBlock Text="除外フォルダー" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock Text="{Binding ExcludedDirsDisplay}" TextWrapping="Wrap"/><TextBlock Text="除外拡張子" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock Text="{Binding ExcludedExtensionsDisplay}" TextWrapping="Wrap"/></StackPanel></GroupBox><GroupBox Header="走査・出力"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="最大階層"/><TextBlock Grid.Column="1" Text="{Binding Filters.MaxDepth}"/><TextBlock Grid.Row="1" Text="隠し項目を含む"/><CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Filters.IncludeHidden}" IsEnabled="False"/><TextBlock Grid.Row="2" Text="空フォルダーを含む"/><CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding Filters.IncludeEmptyDirs}" IsEnabled="False"/><TextBlock Grid.Row="3" Text="形式"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FormatDisplay}"/></Grid></GroupBox></StackPanel></ScrollViewer></Border>
   <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch"/>
   <Border Grid.Column="4" Background="White" CornerRadius="7" Padding="14"><StackPanel><TextBlock Text="重複・類似" FontSize="16" FontWeight="Bold"/><Border Background="#E8F5EE" CornerRadius="5" Padding="8" Margin="0,10"><TextBlock Text="{Binding ExactMessage}" Foreground="#27885C" FontWeight="Bold" TextWrapping="Wrap"/></Border><ItemsControl ItemsSource="{Binding Matches}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E4E8EF" BorderThickness="0,0,0,1" Padding="0,9"><StackPanel><TextBlock Text="{Binding Preset.Name}" FontWeight="Bold"/><TextBlock Text="{Binding ScoreText}" Foreground="#E29421"/><TextBlock Text="{Binding DifferencesText}" FontSize="11" Foreground="#6C7788" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </Grid>
 </DockPanel>
</Window>
