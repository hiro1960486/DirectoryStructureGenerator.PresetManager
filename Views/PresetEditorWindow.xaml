<Window x:Class="DirectoryStructureGenerator.PresetManager.Views.PresetEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="プリセット編集" Width="900" Height="700" WindowStartupLocation="CenterOwner" Background="#F4F6F9">
 <DockPanel Margin="12"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="キャンセル" IsCancel="True"/><Button Content="重複チェックして保存" Click="Save_Click" Background="#2864DC" Foreground="White"/></StackPanel><TabControl>
  <TabItem Header="基本情報"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="名称"/><TextBox Grid.Column="1" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="1" Text="説明"/><TextBox Grid.Row="1" Grid.Column="1" Height="80" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Memo,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Row="2" Text="順番"/><DockPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"><TextBox x:Name="OrderTextBox" Width="120" PreviewKeyDown="OrderTextBox_PreviewKeyDown"/><TextBlock Text="数字を入力し、Enterで確定" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#6C7788"/></DockPanel><StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"><CheckBox Content="既定" IsChecked="{Binding Default}"/><CheckBox Content="クイック" IsChecked="{Binding Quick}" Margin="18,5"/><CheckBox Content="お気に入り" IsChecked="{Binding Favorite}"/></StackPanel></Grid></TabItem>
  <TabItem Header="実行情報"><StackPanel Margin="12"><TextBlock Text="対象フォルダー（空欄の場合は実行時に選択）"/><DockPanel><Button DockPanel.Dock="Right" Content="参照…" Click="BrowseSource_Click"/><TextBox Text="{Binding Source}"/></DockPanel><TextBlock Text="出力先（空欄の場合はアプリの既定値）" Margin="0,12,0,0"/><DockPanel><Button DockPanel.Dock="Right" Content="参照…" Click="BrowseOutput_Click"/><TextBox Text="{Binding Output}"/></DockPanel></StackPanel></TabItem>
  <TabItem Header="対象・除外"><ScrollViewer><StackPanel Margin="12"><TextBlock Text="対象拡張子（改行・カンマ区切り）"/><TextBox x:Name="IncludedText" Height="90" AcceptsReturn="True"/><TextBlock Text="除外フォルダー" Margin="0,10,0,0"/><TextBox x:Name="ExcludedDirsText" Height="90" AcceptsReturn="True"/><TextBlock Text="除外拡張子" Margin="0,10,0,0"/><TextBox x:Name="ExcludedExtText" Height="70" AcceptsReturn="True"/><TextBlock Text="パターン" Margin="0,10,0,0"/><TextBox x:Name="PatternsText" Height="70" AcceptsReturn="True"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="走査設定"><StackPanel Margin="12"><TextBlock Text="最大階層（-1 = 無制限）"/><TextBox Width="120" HorizontalAlignment="Left" Text="{Binding Filters.MaxDepth}"/><CheckBox Content="隠し項目を含める" IsChecked="{Binding Filters.IncludeHidden}"/><CheckBox Content="空フォルダーを含める" IsChecked="{Binding Filters.IncludeEmptyDirs}"/><CheckBox Content="シンボリックリンクをたどる" IsChecked="{Binding Filters.FollowSymlinks}"/></StackPanel></TabItem>
  <TabItem Header="出力・整理"><StackPanel Margin="12"><WrapPanel><CheckBox Content="TXT" IsChecked="{Binding Formats.Txt}"/><CheckBox Content="HTML" IsChecked="{Binding Formats.Html}" Margin="18,5"/><CheckBox Content="CSV" IsChecked="{Binding Formats.Csv}"/><CheckBox Content="JSON" IsChecked="{Binding Formats.Json}" Margin="18,5"/></WrapPanel><CheckBox Content="サブフォルダーを維持" IsChecked="{Binding Organizer.KeepSubfolders}"/><TextBlock Text="重複時" Margin="0,8,0,0"/><ComboBox SelectedValue="{Binding Organizer.Collision}" SelectedValuePath="Content" Width="180" HorizontalAlignment="Left"><ComboBoxItem Content="number"/><ComboBoxItem Content="overwrite"/><ComboBoxItem Content="skip"/></ComboBox></StackPanel></TabItem>
 </TabControl></DockPanel>
</Window>
